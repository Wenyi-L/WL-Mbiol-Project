fx_vec = fx_vec,
sx_vec = sx_vec
)
#set names for fx_vec and sx_vec
fx_vec <- setNames(ifelse(is.na(great_tit$fx), 0, great_tit$fx), great_tit$x)
sx_vec <- setNames(ifelse(is.na(great_tit$sx), 0, great_tit$sx), great_tit$x)
#run the simulation
sim_great_tit <- run_ibm_age_compact(
great_tit,
n.yrs = 50,           # simulate for 50 years
init.pop.size = 500,  # initial population size
start_age = 0,        #assuming everyone is a new recruit
seed = 2025,
recruit_prob = 1,     # all offsprings get recruited into the population
sex_ratio = 0.5,
max_pop = 10000,      # carrying capacity
fx_vec = fx_vec,
sx_vec = sx_vec
)
View(sim_great_tit)
